{
  "manifest_version": 3,
  "name": "FloatingMedia",
  "version": "0.1.3",
  "description": "Seçilen medya adresini FloatingMedia kayan penceresinde açar.",
  "key": "",
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "FloatingMedia'ya gönder",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "floatingmedia@floatingmedia.local",
      "strict_min_version": "109.0"
    }
  },
  "commands": {
    "toggle-pip": {
      "suggested_key": {
        "default": "Alt+P"
      },
      "description": "Sayfadaki videoyu yüzen pencereye al / geri al"
    }
  }
}
